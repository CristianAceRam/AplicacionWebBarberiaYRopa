# ── Frontend — variables de entorno (Vite) ────────────────────────────────────
# Copia este fichero como .env.local (ignorado en git) y rellena los valores.
# IMPORTANTE: Vite hornea estas vars en el build. Si VITE_API_URL no está seteada
# en el momento de `npm run build` (p.ej. en Render Static Site), el banner de
# galería cae a localhost y mostrará estado vacío en producción. Fase 5: configurar
# esta var en el Environment Group de Render antes del deploy.

# URL base del backend FastAPI (sin barra final)
VITE_API_URL=
