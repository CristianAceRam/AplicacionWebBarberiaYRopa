# ── Credenciales requeridas ────────────────────────────────────────────────────
# Para desarrollo local: copiar al archivo .env y ajustar valores
# El docker-compose.yml de la raíz crea un PostgreSQL con estos datos exactos:
DATABASE_URL=postgresql+psycopg://pistia:dev_local@localhost:5432/pistia_db

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-usa-openssl-rand-hex-32

# ── Opcionales (valores por defecto si no se configuran) ──────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
# CORS (formato JSON array) — OBLIGATORIO en producción; default localhost solo en dev
ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Admins del seed (seed.py — CREATE-IF-MISSING, idempotente) ────────────────
# En producción usar contraseñas FUERTES (mínimo 16 chars)
ADMIN1_EMAIL=admin@tudominio.com
ADMIN1_PASSWORD=cambiame-contrasena-fuerte
ADMIN1_NOMBRE=Nombre Apellido
ADMIN1_TELEFONO=600000000

ADMIN2_EMAIL=barbero@tudominio.com
ADMIN2_PASSWORD=cambiame-contrasena-fuerte
ADMIN2_NOMBRE=Nombre Apellido
ADMIN2_TELEFONO=600000000

# ── Telegram (opcional; si no se configura los avisos se omiten silenciosamente) ──
# Crear bot con @BotFather → obtener TELEGRAM_BOT_TOKEN
# Enviar mensaje al bot y abrir api.telegram.org/bot<TOKEN>/getUpdates → chat.id
TELEGRAM_BOT_TOKEN=cambiame-token-del-bot
TELEGRAM_CHAT_ID=cambiame-chat-id

# ── Fase 3 (módulo tienda "Reserva sencilla") — NO DESCOMENTAR HASTA FASE 3 ──
# CLOUDINARY_URL=
